{
	"name": "docwriter",
	"version": "0.0.1",
	"description": "AI-assisted markdown writing editor — run from any repo directory",
	"type": "module",
	"engines": {
		"node": "^20.19 || ^22.12 || >=24"
	},
	"bin": {
		"docwriter": "./bin/docwriter.js"
	},
	"files": [
		"bin/",
		"build/"
	],
	"scripts": {
		"linkme": "npm run setup:link",
		"setup:link": "npm install && npm run build && npm link",
		"dev": "vite dev",
		"dev:workspace": "node bin/docwriter-dev.js",
		"dev:evals": "node bin/docwriter-dev.js --new-session /Users/shreyashankar/Documents/projects/ai-evals-for-engineers",
		"build": "vite build",
		"start": "node bin/docwriter.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "playwright test",
		"test:ui": "playwright test --ui",
		"test:headed": "playwright test --headed"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/better-sqlite3": "^7.6.13",
		"@types/diff": "^7.0.2",
		"@types/node": "^25.5.2",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.2.92",
		"@hocuspocus/provider": "^3.4.4",
		"@hocuspocus/server": "^3.4.4",
		"@tiptap/core": "^3.22.3",
		"@tiptap/extension-collaboration": "^3.22.3",
		"@tiptap/extension-document": "^3.22.4",
		"@tiptap/extension-hard-break": "^3.22.4",
		"@tiptap/extension-paragraph": "^3.22.4",
		"@tiptap/extension-placeholder": "^3.22.3",
		"@tiptap/extension-text": "^3.22.4",
		"@tiptap/pm": "^3.22.3",
		"better-sqlite3": "^12.9.0",
		"diff": "^8.0.4",
		"happy-dom": "^20.9.0",
		"lucide-svelte": "^1.0.1",
		"rough-notation": "^0.5.1",
		"y-indexeddb": "^9.0.12",
		"y-prosemirror": "^1.3.7",
		"yaml": "^2.8.3",
		"yjs": "^13.6.30"
	}
}
