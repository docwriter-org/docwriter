{
	"name": "docwriter",
	"version": "0.0.1",
	"description": "AI-assisted markdown writing editor — run from any repo directory",
	"type": "module",
	"engines": {
		"node": "^20.19 || ^22.12 || >=24"
	},
	"bin": {
		"docwriter": "./bin/docwriter.js"
	},
	"files": [
		"bin/",
		"build/"
	],
	"scripts": {
		"linkme": "npm run setup:link",
		"setup:link": "npm install && npm run build && npm link",
		"dev": "vite dev",
		"dev:workspace": "node bin/docwriter-dev.js",
		"dev:evals": "node bin/docwriter-dev.js --new-session /Users/shreyashankar/Documents/projects/ai-evals-for-engineers",
		"prebuild": "node scripts/setup-pdfjs.mjs",
		"build": "vite build",
		"start": "node bin/docwriter.js",
		"preview": "vite preview",
		"prepare": "node scripts/setup-pdfjs.mjs && svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"docs": "cd docs && npx -y mintlify dev --port 3333",
		"docs:screenshots": "node docs/capture-screenshots.mjs",
		"test:e2e": "node e2e/provider-smoke.mjs",
		"test:e2e:provider": "node e2e/run-provider.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/better-sqlite3": "^7.6.13",
		"@types/diff": "^7.0.2",
		"@types/diff-match-patch": "^1.0.36",
		"@types/node": "^25.5.2",
		"adm-zip": "0.6.0",
		"playwright": "^1.49.0",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.196",
		"@anthropic-ai/sdk": "^0.93.0",
		"@cursor/sdk": "^1.0.18",
		"@earendil-works/pi-ai": "^0.80.2",
		"@earendil-works/pi-coding-agent": "^0.80.2",
		"@hocuspocus/provider": "^3.4.4",
		"@hocuspocus/server": "^3.4.4",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@openai/agents": "^0.11.6",
		"@openai/codex-sdk": "^0.139.0",
		"@sinclair/typebox": "^0.34.49",
		"@tiptap/core": "^3.22.3",
		"@tiptap/extension-collaboration": "^3.22.3",
		"@tiptap/extension-document": "^3.22.4",
		"@tiptap/extension-hard-break": "^3.22.4",
		"@tiptap/extension-paragraph": "^3.22.4",
		"@tiptap/extension-placeholder": "^3.22.3",
		"@tiptap/extension-text": "^3.22.4",
		"@tiptap/extensions": "^3.22.3",
		"@tiptap/pm": "^3.22.3",
		"@tiptap/y-tiptap": "^3.0.5",
		"better-sqlite3": "^12.9.0",
		"diff": "^8.0.4",
		"diff-match-patch": "^1.0.5",
		"happy-dom": "^20.9.0",
		"lucide-svelte": "^1.0.1",
		"marked": "^18.0.3",
		"rough-notation": "^0.5.1",
		"y-indexeddb": "^9.0.12",
		"y-prosemirror": "^1.3.7",
		"y-protocols": "^1.0.7",
		"yaml": "^2.8.3",
		"yjs": "^13.6.30",
		"zod": "^4.4.3"
	}
}
