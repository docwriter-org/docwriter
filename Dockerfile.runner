FROM node:22-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    jq \
    python3 \
    python3-pip \
    build-essential \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /runner

COPY runner/server.js ./server.js

EXPOSE 3000

CMD ["node", "server.js"]
