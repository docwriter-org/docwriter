# Public URL used by Clerk redirect/origin validation in production.
APP_URL=https://docwriter.org

# Clerk auth
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: force the auth gate locally even when Clerk keys are missing.
# CLERK_AUTH_REQUIRED=1

# Optional: DocWriter runtime configuration
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
# DOCWRITER_ROOT=
# DOCWRITER_DEFAULT_MODEL=
# DOCWRITER_WS_PORT=3001
# PUBLIC_DOCWRITER_WS_PORT=3001
