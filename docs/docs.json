				"pages": [
					"reference/how-it-works",
					"help/storage-and-backups",
					"help/shortcuts",
					"help/command-line"
				]
			},
			{
				"group": "Contribute",
				"pages": [
					"contribute/setup",
					"contribute/architecture",
					"contribute/providers-and-tools",
					"contribute/editor-and-persistence",
					"contribute/testing-and-docs"
