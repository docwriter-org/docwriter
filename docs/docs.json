{
	"$schema": "https://mintlify.com/docs.json",
	"theme": "palm",
	"name": "DocWriter",
	"description": "A shared writing workspace for writers and AI agents.",
	"favicon": "/favicon.svg",
	"logo": {
		"light": "/logo/light.svg",
		"dark": "/logo/dark.svg"
	},
	"colors": {
		"primary": "#7c3aed",
		"light": "#a78bfa",
		"dark": "#5b21b6"
	},
	"fonts": {
